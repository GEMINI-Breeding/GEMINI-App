.DS_Store
.env
.env.local

# Editor / IDE
.idea/
.vscode/

# Agent / planning artifacts (local only, never commit)
CLAUDE.md
task_plan.md
findings.md
progress.md
orphan-audit-report.md
orphan-cleanup-handoff.md
# Claude Code: personal state stays local; the project's skills and the
# cluster guard hook are part of the checkout (see agent/SETUP.md, section 6).
.claude/*
!.claude/skills/
!.claude/settings.json

# Frontend test coverage output
frontend/coverage/

# Playwright leftover output (one per failed test, regenerated each run)
test-results/
frontend/test-results/
frontend/playwright-report/

# Local example datasets (multi-GB; not source)
ExampleDatasets/

scratchpad

# Cluster site details (host, account, paths): never committed. Template: hpc/clusters/launch.conf.example
hpc/clusters/*/
hpc/clusters/active

# Built by agent/build_desktop.py before `tauri build`
frontend/src-tauri/binaries/
frontend/src-tauri/agent-resources/

# Working notes of local sessions (machine paths, site details) and local data
/Agent.md
/AGENT_NEW.md
/FieldDesign_*.xlsx
*.tmp.cjs

# Python bytecode
__pycache__/
*.pyc

# second desktop build folder (a build alongside a running copy of the app)
/frontend/src-tauri/target-demo/

# Demo dataset notes: kept locally, not shared
/agent/DEMO_DATASETS.md
